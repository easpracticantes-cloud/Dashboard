# =============================================================================
# SIG — plantilla de entorno (Oracle Cloud / Docker Compose)
# Copiar a .env y completar. NUNCA subir .env con secretos al repositorio.
# =============================================================================

# --- PostgreSQL (interno Docker: host "db") ---
POSTGRES_DB=sig_db
POSTGRES_USER=sig
POSTGRES_PASSWORD=cambia-esta-password-fuerte
# Solo para docker-compose.dev.yml:
# POSTGRES_PORT=5433

# --- Backend Spring Boot ---
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion-min-32-chars
JWT_EXPIRATION_MINUTES=120
JWT_REMEMBER_ME_EXPIRATION_MINUTES=10080
SEED_ENABLED=false

# Orígenes del navegador (tu dominio Oracle). Sin comodines onrender.
# Ejemplo producción:
# CORS_ALLOWED_ORIGINS=https://sig.tudominio.com
# Durante prueba por IP (quitar luego):
# CORS_ALLOWED_ORIGINS=https://sig.tudominio.com,http://IP_PUBLICA_ORACLE
CORS_ALLOWED_ORIGINS=https://TU_DOMINIO_O_IP

# Contabilidad vía red Docker (NO uses URLs públicas)
CONTABLE_API_BASE=http://contabilidad:8787

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=escuelaavescomercial@gmail.com,easpracticantes@gmail.com,escuelaavesdesalento@gmail.com
GOOGLE_DEFAULT_ROLE=GERENCIA

# --- Google Sheets (Apps Script externo; no es Render) ---
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_WRITE_TOKEN=
SHEETS_SYNC_INTERVAL_MS=300000

# --- IA (Claude recomendado como principal) ---
# gemini | anthropic | claude
APP_AI_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-latest,gemini-flash-latest
ANTHROPIC_API_KEY=
# Obligatorio con API keys ligadas a identidad (Console → Workspace → ID)
ANTHROPIC_WORKSPACE_ID=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-4-5-20250929
GEMINI_VISION_ON_WEAK_OCR=true

# Ollama (opcional; local o cloud)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# --- Publicación HTTP (único puerto expuesto por Compose en producción) ---
PUBLIC_HTTP_PORT=80

# Solo docker-compose.dev.yml:
# BACKEND_PORT=8081
# FRONTEND_PORT=5173
# CONTABILIDAD_PORT=8787
