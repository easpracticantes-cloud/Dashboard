# Base de datos
POSTGRES_DB=sig_db
POSTGRES_USER=sig
POSTGRES_PASSWORD=sig
POSTGRES_PORT=5433

# Backend (Render: DB_URL, DB_USER, DB_PASSWORD, JWT_SECRET, CORS_ALLOWED_ORIGINS, SEED_ENABLED)
BACKEND_PORT=8081
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion-min-32-chars
JWT_EXPIRATION_MINUTES=120
JWT_REMEMBER_ME_EXPIRATION_MINUTES=10080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200,https://*.onrender.com,https://dashboard-frontend.onrender.com
SEED_ENABLED=true

# Login con Google (Gmail)
# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID (tipo "Aplicación web") de Google Cloud Console
# GOOGLE_ALLOWED_EMAILS: correos y/o dominios autorizados separados por coma (ej: jefa@gmail.com,@escuelaavessalento.com)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=escuelaavescomercial@gmail.com,easpracticantes@gmail.com,escuelaavesdesalento@gmail.com
GOOGLE_DEFAULT_ROLE=GERENCIA

# Google Gemini (NUNCA pongas la key real aquí; usa .env local o Render Environment)
# gemini-2.5-flash ya no está disponible para usuarios nuevos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APP_AI_PROVIDER=gemini
# En Render (servicio backend dashboard-7spt) → Environment → Add:
#   GEMINI_API_KEY=
#   GEMINI_MODEL=gemini-3.6-flash
#   APP_AI_PROVIDER=gemini
#   CORS_ALLOWED_ORIGINS=https://dashboard-frontend.onrender.com,https://*.onrender.com
#   CONTABLE_API_BASE=https://sig-contabilidad.onrender.com

# Contabilidad (microservicio FastAPI en Render)
CONTABLE_API_BASE=http://localhost:8787

# Frontend
FRONTEND_PORT=5173
