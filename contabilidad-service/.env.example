# Configuracion local — copiar a .env y ajustar

# Base de datos
DATABASE_URL=sqlite:///./data/contable.db

# Almacenamiento de archivos (facturas, excels, comprobantes)
STORAGE_ROOT=./storage

# IA local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=90

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Proveedores
STORAGE_PROVIDER=local
AUTOBITS_PROVIDER=excel
GOOGLE_DRIVE_ENABLED=false

# Servidor web (run_web.py)
APP_HOST=127.0.0.1
APP_PORT=8787
APP_OPEN_BROWSER=1
APP_RELOAD=0
APP_CORS_ORIGINS=*

# Logs y limites
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
