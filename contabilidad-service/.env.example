# Configuracion local — copiar a .env y ajustar

DATABASE_URL=sqlite:///./data/contable.db
STORAGE_ROOT=./storage

# gemini | anthropic | claude | ollama | auto — también acepta APP_AI_PROVIDER
AI_PROVIDER=gemini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=90

GEMINI_API_KEY=
# Usa el MISMO modelo que el backend SIG en Render
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=90
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-latest,gemini-flash-latest
# Si OCR saca poco texto, Gemini lee la imagen directamente
GEMINI_VISION_ON_WEAK_OCR=true

# Anthropic Claude (A4) — Haiku extract / Sonnet review
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-4-5-20250929
# AI_TIMEOUT=90
# AI_MAX_RETRIES=2
# PROCESS_ASYNC_DEFAULT=false

TESSERACT_LANG=spa+eng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

STORAGE_PROVIDER=local
AUTOBITS_PROVIDER=excel
GOOGLE_DRIVE_ENABLED=false

APP_HOST=127.0.0.1
APP_PORT=8787
APP_OPEN_BROWSER=1
APP_RELOAD=0
APP_CORS_ORIGINS=*

LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
