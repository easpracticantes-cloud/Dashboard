# Configuracion local — copiar a .env y ajustar

DATABASE_URL=sqlite:///./data/contable.db
STORAGE_ROOT=./storage

AI_PROVIDER=anthropic
APP_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_REASONING=claude-sonnet-4-5-20250929
CLAUDE_VISION_ON_WEAK_OCR=true

TESSERACT_LANG=spa+eng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

STORAGE_PROVIDER=local
AUTOBITS_PROVIDER=excel
GOOGLE_DRIVE_ENABLED=false

APP_HOST=127.0.0.1
APP_PORT=8787
APP_OPEN_BROWSER=1
APP_RELOAD=0
APP_CORS_ORIGINS=*

LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
